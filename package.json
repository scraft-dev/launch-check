{
  "name": "launch-check",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "test": "tsx --test src/lib/*.test.ts",
    "test:e2e": "node scripts/e2e-smoke.mjs",
    "test:load": "node scripts/load-test.mjs",
    "release:check": "npm run format:check && npm run lint && npm test && npm run build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@sparticuz/chromium": "^149.0.0",
    "lighthouse": "^13.4.1",
    "next": "16.2.12",
    "pdfkit": "^0.17.2",
    "playwright-core": "^1.62.1",
    "react": "19.2.4",
    "react-dom": "19.2.4"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/pdfkit": "^0.17.6",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.12",
    "eslint-config-prettier": "^10.1.8",
    "prettier": "^3.9.6",
    "tailwindcss": "^4",
    "tsx": "^4.23.5",
    "typescript": "^5"
  },
  "overrides": {
    "postcss": "8.5.25",
    "sharp": "0.35.3"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
