# GitHub App settings. Configure values locally or in the deployment platform.
# Never commit the real private key or webhook secret.
APP_URL=
# Use a durable, private filesystem location in production. Vercel /tmp is
# suitable only for previews because data can disappear between invocations.
REPORT_STORE_PATH=
GITHUB_APP_ID=
GITHUB_APP_PRIVATE_KEY=
GITHUB_WEBHOOK_SECRET=

# Team notification settings. Keep all values server-side.
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_SIGNING_SECRET=
DISCORD_WEBHOOK_URL=
DISCORD_PUBLIC_KEY=
